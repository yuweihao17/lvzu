<template>
  <div class="page">
    <div class="screen" if="{{step === 'cleanse'}}" onswipe="handlePageSwipe">
      <div class="dots">
        <div class="dot active"></div>
        <div class="dot"></div>
        <div class="dot"></div>
        <div class="dot"></div>
      </div>
      <div class="top-rule"></div>
      <text class="eyebrow">仪式准备</text>
      <text class="step-title">第一步</text>
      <text class="action-title">净  身</text>
      <div class="gold-rule calm-gold-rule"></div>
      <image class="cleanse-art" src="/common/cleanse-hands-new.png"></image>
      <text class="copy copy-main">请先洗净双手</text>
      <text class="copy copy-main second">以表对仙师之尊敬</text>
      <text class="copy copy-muted">心神方可感应灵签</text>
      <div class="bottom-rule"></div>
      <div class="primary-btn" onclick="goCalm">
        <text class="primary-btn-text">已洁净，继续</text>
      </div>
    </div>

    <div class="screen calm-screen" if="{{step === 'calm'}}" onswipe="handlePageSwipe">
      <div class="dots"><div class="dot active"></div><div class="dot active"></div><div class="dot"></div><div class="dot"></div></div>
      <div class="top-rule"></div>
      <text class="eyebrow">仪式准备</text>
      <text class="step-title">第二步</text>
      <text class="action-title">静  心</text>
      <div class="gold-rule"></div>
      <div class="calm-ring">
        <div class="ring-muted"></div>
        <div class="ring-glow"></div>
        <image class="pray-image" src="/common/calm-pray-hands.png"></image>
        <text class="count-num">{{calmCountdown}}</text>
      </div>
      <text class="copy copy-main calm-copy-main">请闭眼，双手合十</text>
      <div class="chant-box">
        <text class="chant-hint">在心中默念三遍</text>
        <div class="chant-lines">
          <text class="chant-main">吕祖仙师</text>
          <text class="chant-main chant-main-second">指点迷津</text>
        </div>
      </div>
      <text class="copy copy-muted calm-footer">默念完成后自动继续</text>
    </div>

    <div class="screen statement-screen" if="{{step === 'statement'}}" onswipe="handlePageSwipe">
      <div class="dots"><div class="dot active"></div><div class="dot active"></div><div class="dot active"></div><div class="dot"></div></div>
      <div class="top-rule"></div>
      <text class="eyebrow">仪式准备</text>
      <text class="step-title">第三步</text>
      <text class="action-title">陈  述</text>
      <div class="gold-rule"></div>
      <text class="copy copy-muted statement-hint">请在心中依次默想以下内容</text>
      <text class="wish">◆ 你的姓名</text>
      <text class="wish">◆ 出生年月日时</text>
      <text class="wish">◆ 现居住地址</text>
      <text class="wish gold">◆ 今日所求之事</text>
      <div class="primary-btn" onclick="goNotice">
        <text class="primary-btn-text">已陈述完毕</text>
      </div>
    </div>

    <div class="screen notice-screen" if="{{step === 'notice'}}" onswipe="handlePageSwipe">
      <div class="dots"><div class="dot active"></div><div class="dot active"></div><div class="dot active"></div><div class="dot active"></div></div>
      <div class="top-rule"></div>
      <text class="danger-title">求签须知</text>
      <text class="notice-icon">☯</text>
      <text class="warn">今日只可求签一次</text>
      <text class="warn">同一事不可重复问签</text>
      <text class="warn">戏谑之心求之不灵</text>
      <text class="sincere">心  诚  则  灵</text>
      <div class="notice-btn" onclick="goDraw">
        <text class="notice-btn-line">我已知晓</text>
        <text class="notice-btn-line notice-btn-line-second">诚心求签</text>
      </div>
    </div>

    <div class="screen draw-screen" if="{{step === 'draw'}}" onswipe="handlePageSwipe">
      <div class="draw-nav">
        <text class="draw-back" onclick="backPrepare">‹</text>
        <text class="draw-title">吕祖灵签</text>
        <text class="draw-spacer"></text>
      </div>
      <div class="draw-rule"></div>
      <text class="draw-main">诚心摇动手环</text>
      <text class="draw-sub">或点击签筒求签</text>
      <image class="draw-tube-image" src="/common/draw-tube.png"></image>
      <div class="draw-sensing-row">
        <image class="draw-wave" src="/common/draw-sensing-wave.png"></image>
        <text class="draw-sensing-text">感应摇动中</text>
      </div>
      <image class="draw-button-image" src="/common/draw-button-aura.png" onclick="startDraw"></image>
    </div>

    <div class="screen sensing-screen" if="{{step === 'sensing'}}" onswipe="handlePageSwipe">
      <text class="sensing-top">‹ 感应中... ›</text>
      <image class="sensing-oracle" src="/common/sensing-oracle.png"></image>
      <text class="sensing-gold">天地人三才感应</text>
      <text class="sense-title">灵签降示</text>
      <text class="sensing-wait">稍候片刻</text>
      <image class="sensing-progress" src="/common/sensing-progress-glow.png"></image>
      <text class="sensing-footer">正在与仙师感应{{sensingDots}}</text>
    </div>

    <div class="screen result-screen" if="{{step === 'result'}}" onswipe="handleResultSwipe">
      <div class="result-heading">
        <div class="result-heading-line"></div>
        <text class="result-heading-text">吕祖显示</text>
        <div class="result-heading-line"></div>
      </div>
      <div class="result-card">
        <image class="result-frame" src="/common/result-frame.png"></image>
        <div class="result-content">
          <text class="result-prefix">第</text>
          <text class="result-number">{{selectedSignNumber}}</text>
          <text class="result-suffix">签</text>
          <div class="result-title-rule"></div>
          <text class="result-story">{{selectedSign.story}}</text>
        </div>
      </div>
      <text class="result-hint">上滑查看签文详解</text>
      <image class="result-arrows" src="/common/result-light.png"></image>
      <div class="result-bottom-rule"></div>
      <image class="result-button" src="/common/result-swipe.png" onclick="openDetail"></image>
    </div>

    <div class="screen activate-screen" if="{{step === 'activate'}}">
      <text class="activate-title">未激活</text>
      <text class="activate-sub">扫码购买或输入试用码</text>
      <text class="activate-trial">试用码 367017 免费试用 5 分钟</text>
      <div class="activate-code-box" onclick="showDeviceCode">
        <text class="activate-device">{{deviceCode}}</text>
      </div>
      <text class="activate-label">设备码</text>
      <qrcode class="activate-qr" value="{{activationQrValue}}"></qrcode>
      <text class="activate-help">输入激活码 / 试用码</text>
      <text class="activate-input">{{activationCodeText}}</text>
      <div class="activate-keypad">
        <input class="key" type="button" value="1" onclick="press1" />
        <input class="key" type="button" value="2" onclick="press2" />
        <input class="key" type="button" value="3" onclick="press3" />
        <input class="key" type="button" value="4" onclick="press4" />
        <input class="key" type="button" value="5" onclick="press5" />
        <input class="key" type="button" value="6" onclick="press6" />
        <input class="key" type="button" value="7" onclick="press7" />
        <input class="key" type="button" value="8" onclick="press8" />
        <input class="key" type="button" value="9" onclick="press9" />
        <input class="key key-alt" type="button" value="返" onclick="backDraw" />
        <input class="key" type="button" value="0" onclick="press0" />
        <input class="key key-alt" type="button" value="删" onclick="deleteKey" />
      </div>
      <input class="activate-submit" type="button" value="验证激活" onclick="submitActivation" />
      <text class="activate-message">{{activationMessage}}</text>
    </div>
  </div>
</template>
<script>
import router from "@system.router"
import storage from "@system.storage"
import vibrator from "@system.vibrator"
import device from "@system.device"
import { signSummaries } from "../../common/signSummaries.js"
import { getActivationQrValue, makeActivationCode, makeDeviceCode, normalizeCode } from "../../common/activation.js"

const DRAW_KEY = "lvzu_today_draw"
const ACTIVATED_KEY = "lvzu_activated"
const DEVICE_CODE_KEY = "lvzu_device_code"
const TRIAL_END_KEY = "lvzu_trial_end"
const TRIAL_USED_KEY = "lvzu_trial_used"
const TRIAL_CODE = "367017"
const TRIAL_DURATION = 5 * 60 * 1000
const CN_DIGITS = ["零", "一", "二", "三", "四", "五", "六", "七", "八", "九"]

function todayKey() {
  const date = new Date()
  const month = date.getMonth() + 1
  const day = date.getDate()
  return date.getFullYear() + "-" + (month < 10 ? "0" + month : month) + "-" + (day < 10 ? "0" + day : day)
}

function toChineseNumber(num) {
  if (num <= 10) return num === 10 ? "十" : CN_DIGITS[num]
  if (num < 20) return "十" + CN_DIGITS[num % 10]
  const ten = Math.floor(num / 10)
  const one = num % 10
  return CN_DIGITS[ten] + "十" + (one ? CN_DIGITS[one] : "")
}

export default {
  private: {
    step: "cleanse",
    prepareIndex: 0,
    calmCountdown: 6,
    selectedSign: signSummaries[98],
    selectedSignNumber: toChineseNumber(signSummaries[98].id),
    isDrawing: false,
    isNavigatingDetail: false,
    isActivated: false,
    isTrialActive: false,
    trialUsed: false,
    trialEndAt: 0,
    activationInput: "",
    activationMessage: "",
    activationCodeText: "--------",
    deviceCode: "00000000",
    activationQrValue: "",
    calmTimer: null,
    senseTimer: null,
    sensingVibrateTimer: null,
    deviceQueryTimer: null,
    sensingDots: ".",
    sensingDotsTimer: null
  },

  onInit() {
    this.step = "cleanse"
    this.prepareIndex = 0
    this.loadActivation()
    this.loadDeviceCode()
  },

  onDestroy() {
    this.clearTimers()
  },

  tap() {
    try {
      vibrator.vibrate({ mode: "short" })
    } catch (e) {
      console.log("vibrate failed")
    }
  },

  restoreToday() {
    storage.get({
      key: DRAW_KEY,
      default: "",
      success: data => {
        if (!data) return
        try {
          const record = JSON.parse(data)
          if (record.date === todayKey() && record.signId) {
            this.selectedSign = signSummaries[record.signId - 1] || signSummaries[0]
            this.selectedSignNumber = toChineseNumber(this.selectedSign.id)
            this.step = "result"
          }
        } catch (e) {
          console.log("invalid draw cache")
        }
      }
    })
  },

  loadActivation() {
    storage.get({
      key: ACTIVATED_KEY,
      default: "",
      success: data => {
        this.isActivated = data === "1"
      }
    })
    storage.get({
      key: TRIAL_END_KEY,
      default: "",
      success: data => {
        const endAt = parseInt(data, 10) || 0
        this.trialEndAt = endAt
        this.isTrialActive = endAt > Date.now()
      }
    })
    storage.get({
      key: TRIAL_USED_KEY,
      default: "",
      success: data => {
        this.trialUsed = data === "1"
      }
    })
  },

  hasAccess() {
    if (this.isActivated) return true
    if (this.trialEndAt > Date.now()) {
      this.isTrialActive = true
      return true
    }
    this.isTrialActive = false
    return false
  },

  loadDeviceCode() {
    const fallback = makeDeviceCode(Date.now() + "-" + Math.random())
    this.setDeviceCode(fallback)
    storage.get({
      key: DEVICE_CODE_KEY,
      default: "",
      success: data => {
        if (data) this.setDeviceCode(data)
      }
    })
    if (this.deviceQueryTimer) clearTimeout(this.deviceQueryTimer)
    this.deviceQueryTimer = setTimeout(() => {
      this.deviceQueryTimer = null
      this.queryDeviceCode(fallback)
    }, 500)
  },

  queryDeviceCode(fallback) {
    try {
      device.getDeviceId({
        success: data => {
          const raw = data && (data.deviceId || data.device_id || data.id)
          this.setDeviceCode(makeDeviceCode(raw || fallback))
        },
        fail: () => {
          this.saveFallbackDeviceCode()
        }
      })
    } catch (e) {
      this.saveFallbackDeviceCode()
    }
  },

  setDeviceCode(code) {
    this.deviceCode = normalizeCode(code)
    this.activationQrValue = getActivationQrValue(this.deviceCode)
  },

  saveFallbackDeviceCode() {
    storage.set({
      key: DEVICE_CODE_KEY,
      value: this.deviceCode
    })
  },

  saveToday(sign) {
    storage.set({
      key: DRAW_KEY,
      value: JSON.stringify({
        date: todayKey(),
        signId: sign.id
      })
    })
    storage.set({
      key: "lvzu_current_sign",
      value: String(sign.id)
    })
  },

  clearTimers() {
    if (this.calmTimer) {
      clearInterval(this.calmTimer)
      this.calmTimer = null
    }
    if (this.senseTimer) {
      clearTimeout(this.senseTimer)
      this.senseTimer = null
    }
    if (this.sensingVibrateTimer) {
      clearInterval(this.sensingVibrateTimer)
      this.sensingVibrateTimer = null
    }
    if (this.sensingDotsTimer) {
      clearInterval(this.sensingDotsTimer)
      this.sensingDotsTimer = null
    }
    if (this.deviceQueryTimer) {
      clearTimeout(this.deviceQueryTimer)
      this.deviceQueryTimer = null
    }
  },

  goCalm() {
    this.tap()
    this.step = "calm"
    this.prepareIndex = 1
    this.calmCountdown = 6
    if (this.calmTimer) clearInterval(this.calmTimer)
    this.calmTimer = setInterval(() => {
      this.calmCountdown -= 1
      if (this.calmCountdown <= 0) {
        clearInterval(this.calmTimer)
        this.calmTimer = null
        this.step = "statement"
        this.prepareIndex = 2
      }
    }, 1000)
  },

  goNotice() {
    this.tap()
    this.step = "notice"
    this.prepareIndex = 3
  },

  goDraw() {
    this.tap()
    this.step = "draw"
  },

  backPrepare() {
    this.tap()
    this.step = "statement"
    this.prepareIndex = 2
  },

  isExitSwipe(event) {
    const direction = this.getSwipeDirection(event)
    return direction === "right"
  },

  getSwipeDirection(event) {
    const direction = event && (event.direction || event.detail && event.detail.direction || event.value || "")
    return String(direction || "").toLowerCase()
  },

  exitApp() {
    this.tap()
    this.clearTimers()
    router.back()
  },

  handlePageSwipe(event) {
    if (this.isExitSwipe(event)) {
      this.exitApp()
    }
  },

  startDraw() {
    if (this.isDrawing) return
    this.tap()
    if (!this.hasAccess()) {
      this.showActivation()
      return
    }
    this.isDrawing = true
    this.step = "sensing"
    this.startSensingDots()
    this.startSensingVibration()
    const index = Math.floor(Math.random() * signSummaries.length)
    this.selectedSign = signSummaries[index]
    this.selectedSignNumber = toChineseNumber(this.selectedSign.id)
    this.saveToday(this.selectedSign)
    this.senseTimer = setTimeout(() => {
      this.tap()
      this.step = "result"
      this.isDrawing = false
      this.senseTimer = null
      if (this.sensingVibrateTimer) {
        clearInterval(this.sensingVibrateTimer)
        this.sensingVibrateTimer = null
      }
      if (this.sensingDotsTimer) {
        clearInterval(this.sensingDotsTimer)
        this.sensingDotsTimer = null
      }
    }, 5000)
  },

  showActivation() {
    this.clearTimers()
    this.activationInput = ""
    this.activationCodeText = "--------"
    this.activationMessage = this.trialEndAt > Date.now() ? "试用剩余 " + Math.ceil((this.trialEndAt - Date.now()) / 60000) + " 分钟" : "激活后只需验证一次"
    this.step = "activate"
  },

  showDeviceCode() {
    this.tap()
    this.activationMessage = "设备码：" + this.deviceCode
  },

  appendActivationKey(key) {
    this.tap()
    if (!key || this.activationInput.length >= 8) return
    this.activationInput = normalizeCode(this.activationInput + key)
    this.activationCodeText = this.activationInput + "--------".slice(this.activationInput.length)
    this.activationMessage = ""
  },

  press0() {
    this.appendActivationKey("0")
  },

  press1() {
    this.appendActivationKey("1")
  },

  press2() {
    this.appendActivationKey("2")
  },

  press3() {
    this.appendActivationKey("3")
  },

  press4() {
    this.appendActivationKey("4")
  },

  press5() {
    this.appendActivationKey("5")
  },

  press6() {
    this.appendActivationKey("6")
  },

  press7() {
    this.appendActivationKey("7")
  },

  press8() {
    this.appendActivationKey("8")
  },

  press9() {
    this.appendActivationKey("9")
  },

  deleteKey() {
    this.tap()
    this.activationInput = this.activationInput.slice(0, -1)
    this.activationCodeText = this.activationInput + "--------".slice(this.activationInput.length)
  },

  backDraw() {
    this.tap()
    this.step = "draw"
  },

  submitActivation() {
    this.tap()
    const code = normalizeCode(this.activationInput)
    if (code === TRIAL_CODE) {
      if (this.trialUsed || this.trialEndAt > 0) {
        this.activationMessage = "试用码已使用过"
        return
      }
      const endAt = Date.now() + TRIAL_DURATION
      this.trialEndAt = endAt
      this.isTrialActive = true
      this.trialUsed = true
      storage.set({
        key: TRIAL_END_KEY,
        value: String(endAt),
        success: () => {
          storage.set({
            key: TRIAL_USED_KEY,
            value: "1"
          })
          this.activationMessage = "试用已开启 5 分钟"
          this.step = "draw"
        }
      })
      return
    }
    if (code.length !== 8) {
      this.activationMessage = "请输入 8 位激活码"
      return
    }
    if (code !== makeActivationCode(this.deviceCode)) {
      this.activationMessage = "激活码错误"
      return
    }
    this.isActivated = true
    storage.set({
      key: ACTIVATED_KEY,
      value: "1",
      success: () => {
        this.activationMessage = "激活成功"
        this.step = "draw"
      }
    })
  },

  startSensingDots() {
    let count = 1
    this.sensingDots = "."
    if (this.sensingDotsTimer) clearInterval(this.sensingDotsTimer)
    this.sensingDotsTimer = setInterval(() => {
      count = count >= 3 ? 1 : count + 1
      this.sensingDots = count === 1 ? "." : count === 2 ? ".." : "..."
    }, 420)
  },

  startSensingVibration() {
    if (this.sensingVibrateTimer) clearInterval(this.sensingVibrateTimer)
    this.tap()
    this.sensingVibrateTimer = setInterval(() => {
      this.tap()
    }, 700)
  },

  openDetail() {
    if (this.isNavigatingDetail) return
    this.isNavigatingDetail = true
    this.tap()
    let navigated = false
    const go = () => {
      if (navigated) return
      navigated = true
      router.push({
        uri: "/pages/detail"
      })
      setTimeout(() => {
        this.isNavigatingDetail = false
      }, 800)
    }
    storage.set({
      key: "lvzu_current_sign",
      value: String(this.selectedSign.id),
      success: go,
      fail: go
    })
    setTimeout(go, 180)
  },

  handleResultSwipe(event) {
    if (this.isExitSwipe(event)) {
      this.exitApp()
      return
    }
    if (this.getSwipeDirection(event) === "up") {
      this.openDetail()
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #050715;
}

.screen {
  width: 100%;
  height: 100%;
  padding-left: 12px;
  padding-right: 12px;
  padding-top: 16px;
  padding-bottom: 18px;
  align-items: center;
  flex-direction: column;
  background-color: #050715;
}

.dots {
  width: 96px;
  height: 18px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.dot {
  width: 8px;
  height: 8px;
  margin-left: 6px;
  margin-right: 6px;
  border-radius: 4px;
  background-color: #343849;
}

.active {
  background-color: #d8b75e;
}

.top-rule,
.bottom-rule {
  width: 170px;
  height: 1px;
  background-color: rgba(114, 122, 154, 0.35);
}

.top-rule {
  margin-top: 4px;
  margin-bottom: 14px;
}

.eyebrow {
  color: #8e909d;
  font-size: 16px;
  text-align: center;
}

.step-title {
  margin-top: 8px;
  color: #d8b75e;
  font-size: 34px;
  font-weight: bold;
  text-align: center;
}

.action-title {
  margin-top: 1px;
  color: #f4f0eb;
  font-size: 29px;
  font-weight: bold;
  text-align: center;
}

.gold-rule {
  width: 90px;
  height: 2px;
  margin-top: 8px;
  margin-bottom: 10px;
  border-radius: 1px;
  background-color: #d8b75e;
}

.cleanse-art {
  width: 158px;
  height: 162px;
  margin-top: 4px;
  margin-bottom: 12px;
}

.copy {
  width: 188px;
  text-align: center;
}

.copy-main {
  color: #ffffff;
  font-size: 21px;
  line-height: 27px;
}

.second {
  margin-top: 4px;
}

.copy-muted {
  margin-top: 8px;
  color: #8f909d;
  font-size: 18px;
  line-height: 23px;
}

.bottom-rule {
  margin-top: 13px;
  margin-bottom: 10px;
}

.primary-btn,
.danger-btn {
  width: 160px;
  height: 42px;
  border-radius: 21px;
  font-size: 19px;
  font-weight: bold;
}

.primary-btn {
  color: #1a1400;
  background-color: #d8b75e;
}

.calm-ring {
  width: 150px;
  height: 150px;
  margin-top: 12px;
  margin-bottom: 14px;
  border-width: 9px;
  border-color: #d8b75e;
  border-radius: 75px;
  align-items: center;
  justify-content: center;
  background-color: #11183b;
}

.pray-symbol {
  color: #d8b75e;
  font-size: 24px;
}

.count-num {
  margin-top: 8px;
  color: #d8b75e;
  font-size: 36px;
}

.chant-line,
.wish,
.gold-text {
  width: 178px;
  margin-top: 12px;
  color: #d8b75e;
