<template>
  <div class="detail-page">
    <div class="full-meaning-page" if="{{viewMode === 'fullMeaning'}}">
      <div class="full-topbar">
        <text class="full-back" onclick="closeFullMeaning">←</text>
        <text class="full-title">{{fullTitle}}</text>
        <text class="full-spacer"></text>
      </div>
      <text class="full-sign-title">{{sign.title}}</text>
      <text class="full-story">{{sign.story}}</text>
      <div class="full-rule"></div>
      <scroll class="full-scroll" scroll-y="true" bounces="true">
        <div class="full-scroll-inner">
          <text class="full-body">{{fullText}}</text>
        </div>
      </scroll>
    </div>

    <div class="paper-bg" if="{{viewMode === 'detail'}}"></div>

    <div class="topbar" if="{{viewMode === 'detail'}}">
      <text class="back" onclick="goBack">‹</text>
      <text class="title">{{sign.title}}</text>
      <text class="top-spacer"></text>
    </div>

    <div class="tabs" if="{{viewMode === 'detail'}}">
      <text class="{{tab === 'explain' ? 'tab tab-active' : 'tab'}}" onclick="showExplain">解签</text>
      <text class="{{tab === 'poemExplain' ? 'tab tab-active' : 'tab'}}" onclick="showPoemExplain">解诗</text>
      <text class="{{tab === 'meaning' ? 'tab tab-active' : 'tab'}}" onclick="showMeaning">解曰</text>
    </div>

    <div class="detail-content poem-content" if="{{viewMode === 'detail' && tab === 'explain'}}">
      <text class="story-title">{{sign.story}}</text>
      <div class="ornament">
        <div class="ornament-dot"></div>
        <div class="ornament-line"></div>
        <div class="ornament-dot"></div>
      </div>
      <div class="poem-card">
        <text class="small-muted">签  文</text>
        <text class="poem-line" for="{{line in oracleLines}}">{{line}}</text>
        <text class="touch-tip">点击逐句查看注解</text>
      </div>
      <div class="summary-card">
        <div class="section-head">
          <text class="section-title">解签</text>
          <text class="expand" onclick="showFullExplain">展开 ›</text>
        </div>
        <text class="summary-copy">{{shortExplain}}</text>
      </div>
    </div>

    <div class="detail-content poem-explain-content" if="{{viewMode === 'detail' && tab === 'poemExplain'}}">
      <div class="poem-card poem-say-card">
        <text class="small-muted">诗  曰</text>
        <text class="poem-line poem-say-line" for="{{line in poemSayLines}}">{{line}}</text>
      </div>
      <div class="summary-card poem-summary">
        <div class="section-head">
          <text class="section-title">解诗</text>
          <text class="expand" onclick="showFullPoemExplain">展开 ›</text>
        </div>
        <text class="summary-copy">{{shortPoemExplain}}</text>
      </div>
    </div>

    <div class="detail-content meaning-content" if="{{viewMode === 'detail' && tab === 'meaning'}}">
      <div class="grid-bg"></div>
      <scroll class="meaning-scroll" scroll-y="true">
        <div class="meaning-scroll-inner">
          <div class="{{item.rowClass}}" for="{{item in categories}}">
            <div class="row-accent"></div>
            <text class="meaning-name">{{item.name}}</text>
            <text class="{{item.textClass}}">{{item.text}}</text>
          </div>
        </div>
      </scroll>
      <div class="exit-button" onclick="exitApp">
        <text class="exit-text">退出</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import vibrator from "@system.vibrator"
import app from "@system.app"
import { signs } from "../../common/signs.js"

export default {
  private: {
    viewMode: "detail",
    tab: "explain",
    sign: signs[98],
    oracleLines: [],
    poemSayLines: [],
    categories: [],
    shortPoemExplain: "",
    shortExplain: "",
    fullTitle: "全部释义",
    fullText: "",
    finalWord: "求得此签，诸事循序渐进"
  },

  onInit() {
    this.loadSign()
  },

  doVibrate() {
    try {
      vibrator.vibrate({ mode: "short" })
    } catch (e) {
      console.log("vibrate failed")
    }
  },

  loadSign() {
    storage.get({
      key: "lvzu_current_sign",
      default: "99",
      success: data => {
        const id = parseInt(data, 10) || 99
        this.setSign(signs[id - 1] || signs[98])
      },
      fail: () => {
        this.setSign(signs[98])
      }
    })
  },

  setSign(sign) {
    this.sign = sign
    this.oracleLines = this.splitText(sign.oracle, 4)
    this.poemSayLines = this.splitText(sign.poem && sign.poem.length ? sign.poem.join("，") : "", 4)
    this.categories = (sign.categories || []).slice(0, 8).map(item => this.buildMeaningRow(item))
    this.shortPoemExplain = this.clip(sign.poemExplain || "", 58)
    this.shortExplain = this.clip(sign.explain || "", 58)
    this.fullTitle = "全部释义"
    this.fullText = ""
    this.viewMode = "detail"
    this.finalWord = this.buildFinalWord(sign)
  },

  splitText(text, max) {
    return (text || "").split(/[，；。;]/).map(item => item.trim()).filter(Boolean).slice(0, max)
  },

  buildMeaningRow(item) {
    const text = item.text || ""
    const len = text.length
    const rowClass = len > 20 ? "meaning-row meaning-row-3" : len > 10 ? "meaning-row meaning-row-2" : "meaning-row"
    const textClass = len > 20 ? "meaning-text meaning-text-3" : len > 10 ? "meaning-text meaning-text-2" : "meaning-text"
    return {
      name: item.name,
      text,
      rowClass,
      textClass
    }
  },

  clip(text, max) {
    if (!text) return ""
    return text.length > max ? text.slice(0, max) + "..." : text
  },

  buildFinalWord(sign) {
    const first = sign.categories && sign.categories[0]
    if (!first) return "求得此签，宜静心守正"
    return "求得此签，" + first.text.replace(/[。.]$/, "")
  },

  showExplain() {
    this.doVibrate()
    this.tab = "explain"
  },

  showPoemExplain() {
    this.doVibrate()
    this.tab = "poemExplain"
  },

  showFullExplain() {
    this.doVibrate()
    this.fullTitle = "全部解签"
    this.fullText = this.sign.explain || ""
    this.viewMode = "fullMeaning"
  },

  showFullPoemExplain() {
    this.doVibrate()
    this.fullTitle = "全部解诗"
    this.fullText = this.sign.poemExplain || ""
    this.viewMode = "fullMeaning"
  },

  closeFullMeaning() {
    this.doVibrate()
    this.viewMode = "detail"
  },

  showMeaning() {
    this.doVibrate()
    this.tab = "meaning"
  },

  goBack() {
    this.doVibrate()
    if (this.viewMode === "fullMeaning") {
      this.viewMode = "detail"
      return
    }
    router.back()
  },

  exitApp() {
    this.doVibrate()
    app.terminate()
  }
}
</script>

