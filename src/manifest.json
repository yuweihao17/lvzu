{
  "package": "com.application.watch.lvzu",
  "name": "吕祖灵签",
  "versionName": "1.0.1",
  "versionCode": 2,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.vibrator"
    },
    {
      "name": "system.app"
    },
    {
      "name": "system.device"
    },
    {
      "name": "system.brightness"
    }
  ],
  "permissions": [
    {
      "origin": "*",
      "name": "hapjs.permission.DEVICE_INFO"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": "device-width"
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      },
      "pages/detail": {
        "component": "detail"
      }
    }
  }
}