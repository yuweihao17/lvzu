{
  "name": "BAZI",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=8.10"
  },
  "scripts": {
    "start": "node scripts/start-vela.js",
    "build": "aiot build",
    "release": "aiot release",
    "lint": "eslint --fix src/common/*.js scripts/*.js"
